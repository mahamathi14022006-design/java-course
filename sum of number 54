import java.util.*;

class SumCalculator {
    int sum(int a, int b) {
        return a + b;
    }
    int sum(int a, int b, int c) {
        return a + b + c;
    }
    double sum(double a, double b) {
        return a + b;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        SumCalculator calc = new SumCalculator();
        ArrayList<String> input = new ArrayList<>();

        while (sc.hasNext()) {
            input.add(sc.next());
        }
        if (input.size() == 2) {
            if (input.get(0).contains(".") || input.get(1).contains(".")) {
                double a = Double.parseDouble(input.get(0));
                double b = Double.parseDouble(input.get(1));
                System.out.println(calc.sum(a, b));
            } else {
                int a = Integer.parseInt(input.get(0));
                int b = Integer.parseInt(input.get(1));
                System.out.println(calc.sum(a, b));
            }
        } 
        else if (input.size() == 3) {
            int a = Integer.parseInt(input.get(0));
            int b = Integer.parseInt(input.get(1));
            int c = Integer.parseInt(input.get(2));
            System.out.println(calc.sum(a, b, c));
        }

        sc.close();
    }
}
